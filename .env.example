# Copy this file to .env and fill in real values for local development:
#   cp .env.example .env
# .env is already in .gitignore — never commit real secrets.
#
# On Vercel, none of this goes in a file — you set each of these as an
# Environment Variable in the Vercel project's Settings, and Vercel injects
# them into the running function the same way os.environ.get(...) reads
# them here.

# ---- Database ----
# Not set (or commented out) -> falls back to a local SQLite file
# (./local.db) for zero-setup local development.
# In production (Vercel), this MUST be a real Postgres connection string —
# e.g. from Vercel Postgres, Neon, or Supabase — never SQLite, since
# Vercel's filesystem is not persistent across invocations.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# ---- Sessions / auth ----
# Required. Signs the login session tokens (JWTs) — anyone who has this
# value could forge a valid login session, so keep it secret and use a
# long random value. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# How long a login session stays valid, in hours. 168 = 7 days.
SESSION_TTL_HOURS=168

# Set to "false" only for local HTTP development (no HTTPS) so the browser
# will actually store the session cookie. Leave it at the default (true,
# or just unset) everywhere else — Vercel deployments are always HTTPS.
COOKIE_SECURE=true

# ---- Abuse protection ----
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=10
