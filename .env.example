# Copy this file to .env and fill in real values for local development:
#   cp .env.example .env
# .env is already in .gitignore — never commit real secrets.
#
# On Vercel, none of this goes in a file — you set each of these as an
# Environment Variable in the Vercel project's Settings, and Vercel injects
# them into the running function the same way os.environ.get(...) reads
# them here.

# ---- Database ----
# Not set (or commented out) -> falls back to a local SQLite file
# (./local.db) for zero-setup local development.
# In production (Vercel), this MUST be a real Postgres connection string —
# e.g. from Vercel Postgres, Neon, or Supabase — never SQLite, since
# Vercel's filesystem is not persistent across invocations.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# ---- Sessions / auth ----
# Required. Signs the login session tokens (JWTs) — anyone who has this
# value could forge a valid login session, so keep it secret and use a
# long random value. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# How long a login session stays valid, in hours. 168 = 7 days.
SESSION_TTL_HOURS=168

# Set to "false" only for local HTTP development (no HTTPS) so the browser
# will actually store the session cookie. Leave it at the default (true,
# or just unset) everywhere else — Vercel deployments are always HTTPS.
COOKIE_SECURE=true

# ---- Google sign-in ("Continue with Google") ----
# The OAuth client ID from Google Cloud Console (APIs & Services ->
# Credentials -> OAuth 2.0 Client IDs -> "Web application"). This is NOT a
# secret — Google's own docs describe it as safe to expose to the browser,
# since the frontend's Google Identity Services library (index.html /
# login.html) needs it directly to render the "Continue with Google"
# button. What keeps Google sign-in secure is backend/google_auth.py
# verifying every credential server-side against this exact client ID —
# see that module for details.
#
# For local development, add http://localhost:8000 and
# http://127.0.0.1:8000 as "Authorized JavaScript origins" for this client
# ID in Google Cloud Console. Before deploying, add your real production
# domain(s) there too — see backend/google_auth.py's docstring and this
# project's auth implementation report for what else that needs.
GOOGLE_CLIENT_ID=

# How long a "verify your email" link stays valid, in hours. Optional --
# defaults to 24 if unset. See backend/email_verification.py.
# EMAIL_VERIFY_TTL_HOURS=24

# ---- Admin access ----
# Note: no route in this FastAPI backend currently reads ADMIN_KEY — the
# old Node backend's /admin dashboard wasn't carried into this migration.
# Set here now so it's ready if that feature gets built later.
ADMIN_KEY=

# ---- Transactional email (SMTP) ----
# Used by backend/email_sender.py to send the "verify your email" link
# after signup (see backend/database.py's email_verified column). These
# names are intentionally provider-neutral -- any STARTTLS-capable SMTP
# provider works here, not just one specific service. SMTP_USER is the
# SMTP login name; SMTP_FROM is the address that appears in the "From"
# header (kept separate from SMTP_USER since some providers allow sending
# as a verified alias distinct from the login name). SMTP_PASSWORD is a
# real secret -- set it only in your local .env (never committed) or as a
# Vercel Environment Variable in production, never here. Leave any of
# these blank to skip sending real email in local development:
# signup/resend still work, they just log that delivery isn't configured
# instead of emailing anyone (see backend/email_sender.py's
# is_email_configured()).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Note: nothing in this FastAPI backend currently reads NOTIFY_TO — the old
# Node backend's lead-notification email wasn't carried into this
# migration. Left here in case that feature gets built later.
NOTIFY_TO=

# ---- Cross-origin ----
# Note: no CORS middleware is currently wired up in api/index.py to read
# this either (same-origin deployment doesn't need it). Left blank.
ALLOWED_ORIGIN=

# ---- Abuse protection ----
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=10
