# Copy this file to .env and fill in real values.
# .env is already in .gitignore — never commit it.

# ---- Server ----
PORT=3001
# Public URL this backend is reachable at, once deployed (used only to build
# the "View all leads" link in notification emails). Leave blank locally.
APP_BASE_URL=

# ---- Database ----
# Where the SQLite lead database file lives. Defaults to ./data/leads.db.
LEADS_DB_PATH=./data/leads.db

# ---- Admin access ----
# Required to view /admin, list/export leads, or resend a notification.
# Generate a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=

# ---- Gmail notification (App Password method) ----
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
#    (choose "Mail" / "Other", name it "Zoey Wallet backend")
# 3. Paste the Gmail address below, and the 16-character app password
#    (spaces in the password are fine, they're stripped automatically).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where lead notification emails should be sent. Can be the same as
# GMAIL_USER, or a different inbox.
NOTIFY_TO=

# ---- Cross-origin (only if the frontend is hosted on a different origin
# than this backend — leave blank for the recommended same-origin setup) ----
ALLOWED_ORIGIN=

# ---- Abuse protection ----
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=10
# Salt used only to hash submitter IPs before they're stored (so raw IPs
# never touch disk). Change this to any random string.
IP_HASH_SALT=change-me-to-something-random

# Only set to true if this server sits behind a trusted reverse proxy /
# load balancer that sets X-Forwarded-For (otherwise visitors could spoof
# their rate-limit identity).
TRUST_PROXY=false

# ---- Notification retry ----
# How often (minutes) the background job retries any lead whose
# notification email never went out. Set to 0 to disable the background
# sweep (you can still retry manually via `npm run retry-failed` or the
# admin dashboard's "Resend" button).
RETRY_INTERVAL_MIN=15
RETRY_MAX_ATTEMPTS=5
